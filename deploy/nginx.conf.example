
# Sistema Web de Ventas e Inventario
# Configuracion de Nginx como proxy inverso hacia Tomcat 10
# Servidor: Ubuntu 24.04 LTS - Microsoft Azure
#
# Archivo de ejemplo. No contiene certificados HTTPS.
# Ajustar server_name al dominio o IP del servidor.

server {
    listen 80;
    server_name 57.156.71.74;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
